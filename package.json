{
  "name": "qwen-model-studio",
  "version": "0.1.0",
  "description": "Local three.js model generation, preview and GLB export with an OpenAI-compatible Qwen server",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "evaluate": "node scripts/evaluate.mjs",
    "report:baseline": "node scripts/report.mjs",
    "licenses": "node scripts/licenses.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release:source": "node scripts/release.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "esbuild": "0.25.9",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
